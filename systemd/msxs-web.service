[Unit]
Description=Media Syntaxis Streamer - panel web
After=msxs-mediamtx.service

[Service]
Type=simple
User=mediasat
WorkingDirectory=/home/mediasat/streamer/streamer
Environment=MSXS_BASE=/home/mediasat/streamer
ExecStart=/home/mediasat/streamer/venv/bin/uvicorn servidor:app --host 0.0.0.0 --port 8095
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
